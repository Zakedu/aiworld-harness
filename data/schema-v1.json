{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI World Component Schema v1.0",
  "description": "기존 aiworld-main의 template-structure.md + quiz-types.md 기준 canonical schema",
  "definitions": {
    "difficulty": {
      "type": "string",
      "enum": ["상", "중상", "중", "중하", "하"]
    },
    "passing_score": {
      "type": "integer",
      "enum": [0, 50, 55, 75, 80, 85]
    },
    "chapter_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]?-[1-9][0-9]?$",
      "description": "파트-챕터 형식, 예: 1-1, 3-2"
    },
    "course_overview": {
      "type": "object",
      "required": ["course_name", "category", "character_name", "sell_reason", "project_outcome", "targets", "effects", "learning_objectives", "learner_persona", "adjacent_jobs", "final_part_pattern", "curriculum"],
      "properties": {
        "course_name":   { "type": "string", "description": "{위인}의 {동사} — {부제목}" },
        "category":      { "type": "string", "minLength": 1, "description": "6개 기본 카테고리 중 하나 또는 사용자가 직접 입력한 자유 문자열" },
        "character_name":{ "type": "string" },
        "sell_reason":   { "type": "string", "maxLength": 40 },
        "project_outcome": { "type": "string" },
        "targets":       { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 3 },
        "effects":       { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 3 },
        "learning_objectives": { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 5 },
        "learner_persona": { "type": "string", "minLength": 20, "maxLength": 220 },
        "adjacent_jobs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": ["job_label", "job_context"],
            "properties": {
              "job_label": { "type": "string" },
              "job_context": { "type": "string", "minLength": 20 }
            }
          },
          "description": "주력 직무 외 AI 활용 빈도 높은 인접 직무 2종. material 실전 시나리오 B·C에서 사용."
        },
        "final_part_pattern": {
          "type": "object",
          "required": ["id", "label", "rationale"],
          "properties": {
            "id": { "type": "string", "enum": ["integration", "library", "simulation", "extension", "retrospective"] },
            "label": { "type": "string" },
            "rationale": { "type": "string", "minLength": 20, "maxLength": 220 }
          }
        },
        "figure_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "technique"],
            "properties": {
              "action": { "type": "string" },
              "technique": { "type": "string" }
            }
          },
          "minItems": 5,
          "maxItems": 10
        },
        "part_workflow_labels": { "type": "array", "items": {"type":"string"}, "minItems": 5, "maxItems": 5 },
        "curriculum":    { "type": "array", "items": {"$ref": "#/definitions/curriculum_row"}, "minItems": 1, "maxItems": 50 }
      }
    },
    "curriculum_row": {
      "type": "object",
      "required": ["chapter_id", "part_name", "chapter_name", "prompt_technique"],
      "properties": {
        "chapter_id":        { "$ref": "#/definitions/chapter_id" },
        "part_name":         { "type": "string" },
        "chapter_name":      { "type": "string" },
        "prompt_technique":  { "type": "string" },
        "material_url":      { "type": ["string","null"] },
        "drive_url":         { "type": ["string","null"] },
        "done":              { "type": "boolean", "default": false }
      }
    },
    "figure_rationale": {
      "type": "object",
      "description": "위인 선정 배경 — 왜 이 위인이 이 주제에 적합한가. 코스당 1개.",
      "required": ["figure_name", "character_alias", "character_keywords", "figure_background", "core_philosophy", "topic_fit_reason", "what_learner_gets", "key_episodes", "opening_one_liner", "signature_workflow", "real_quotes"],
      "properties": {
        "figure_name":        { "type": "string" },
        "character_alias":    { "type": "string", "description": "위인 역할 별칭" },
        "character_keywords": { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 4 },
        "figure_background":  { "type": "string", "minLength": 80, "maxLength": 250 },
        "core_philosophy":    { "type": "string", "minLength": 150, "maxLength": 400 },
        "topic_fit_reason":   { "type": "string", "minLength": 200, "maxLength": 700 },
        "intro_narrative":    { "type": "string", "minLength": 120, "maxLength": 500 },
        "action_technique_map": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["action", "technique"],
            "properties": {
              "action": { "type": "string" },
              "technique": { "type": "string" }
            }
          },
          "minItems": 5,
          "maxItems": 10
        },
        "part_growth_curves": {
          "type": "array",
          "items": {"type": "object"},
          "minItems": 1,
          "maxItems": 10
        },
        "part_workflow_roadmap": {
          "type": "array",
          "items": {"type": "object"},
          "minItems": 1,
          "maxItems": 10
        },
        "what_learner_gets":  { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 5 },
        "signature_workflow": {
          "type": "object",
          "required": ["name", "steps", "rationale"],
          "properties": {
            "name": { "type": "string", "minLength": 4, "maxLength": 30 },
            "steps": { "type": "array", "items": {"type":"string"}, "minItems": 3, "maxItems": 5 },
            "rationale": { "type": "string", "minLength": 40, "maxLength": 220 }
          }
        },
        "key_episodes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["title", "description", "source"],
            "properties": {
              "title":       { "type": "string" },
              "description": { "type": "string", "minLength": 100, "maxLength": 400 },
              "source":      { "type": "string" },
              "source_url":  { "type": "string" }
            }
          }
        },
        "real_quotes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["text", "original", "context", "source", "source_url"],
            "properties": {
              "text": { "type": "string" },
              "original": { "type": "string" },
              "context": { "type": "string" },
              "source": { "type": "string" },
              "source_url": { "type": "string" }
            }
          }
        },
        "opening_one_liner":  { "type": "string", "maxLength": 30 }
      }
    },
    "material_chapter": {
      "type": "object",
      "description": "챕터별 학습자료 본문 — 순수 학습 콘텐츠 5섹션 (스토리/브릿지는 story_chapter로 분리)",
      "required": ["chapter_id", "sections"],
      "properties": {
        "chapter_id": { "$ref": "#/definitions/chapter_id" },
        "sections": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["heading", "body"],
            "properties": {
              "heading": { "type": "string" },
              "body":    { "type": "string" },
              "kind":    { "type": "string", "enum": ["background_knowledge", "empathy_opener", "concept", "example", "template", "reflection"] }
            }
          }
        }
      }
    },
    "story_chapter": {
      "type": "object",
      "description": "챕터별 인트로 스토리 — 스토리 본문 + 이미지 생성 프롬프트. story_writer가 생성.",
      "required": ["chapter_id", "story_body", "image_prompt"],
      "properties": {
        "chapter_id":         { "$ref": "#/definitions/chapter_id" },
        "story_body":         { "type": "string", "minLength": 250, "maxLength": 900, "description": "자연스러운 한 덩어리 글, 마커 없음" },
        "image_prompt":       { "type": "string", "minLength": 80, "maxLength": 600, "description": "행동·배경·구도·상황 묘사. 외형·표정 묘사 없음" }
      }
    },
    "quiz_item": {
      "type": "object",
      "required": ["chapter_id", "type", "difficulty", "title", "question", "hint", "choices", "answer", "category", "explanation"],
      "properties": {
        "chapter_id":    { "$ref": "#/definitions/chapter_id" },
        "clip_group_id": { "type": "string", "default": "-" },
        "is_free":       { "type": "string", "enum": ["TRUE"], "default": "TRUE" },
        "type":          { "type": "string", "enum": ["OX", "단일선택", "복수선택", "분류", "단답형"] },
        "difficulty":    { "$ref": "#/definitions/difficulty" },
        "title":         { "type": "string", "maxLength": 75 },
        "question":      { "type": "string", "maxLength": 150 },
        "hint":          { "type": "string" },
        "choices":       { "type": "string", "description": "-  또는 (1)...(n) 형식" },
        "answer":        { "type": "string" },
        "category":      { "type": "string" },
        "explanation":   { "type": "string", "description": "(정답이유)(오답반박)(실무예시) 3요소" }
      }
    },
    "practice_item": {
      "type": "object",
      "required": ["chapter_id", "stage", "title", "question", "description", "difficulty", "answer", "passing_score", "criteria"],
      "properties": {
        "chapter_id":    { "$ref": "#/definitions/chapter_id" },
        "clip_group_id": { "type": "string", "default": "-" },
        "is_free":       { "type": "string", "enum": ["FALSE"], "default": "FALSE" },
        "stage":         { "type": "string", "enum": ["실험", "레슨", "도전"] },
        "learning_point": { "type": "string", "description": "이 실습이 검증하는 핵심 학습 능력 1줄" },
        "practice_role":  { "type": "string", "enum": ["BAD", "GOOD"], "description": "실험=BAD, 레슨/도전=GOOD" },
        "title":         { "type": "string", "maxLength": 100, "description": "{위인}의 {단계} — {구체적 동작}" },
        "question":      { "type": "string", "maxLength": 150, "description": "위인 화법 + ~하시오 어미" },
        "description":   { "type": "string", "maxLength": 140, "description": "위인 원칙 + * 기호로 조건 구분" },
        "file_url":      { "type": "string", "default": "-" },
        "environment":   { "type": "string", "enum": ["ChatGPT", "Claude", "Gemini"], "default": "ChatGPT" },
        "difficulty":    { "$ref": "#/definitions/difficulty" },
        "answer":        { "type": "string", "description": "모범 프롬프트 (good/better 형태)" },
        "passing_score": { "$ref": "#/definitions/passing_score" },
        "response_type": { "type": "string", "enum": ["텍스트"], "default": "텍스트" },
        "criteria": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["title", "description"],
            "properties": {
              "title":       { "type": "string", "pattern": ".+했나요\\?$" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "quiz_chapter_set": {
      "type": "object",
      "description": "챕터 1개의 퀴즈 10문항 세트",
      "required": ["chapter_id", "items"],
      "properties": {
        "chapter_id": { "$ref": "#/definitions/chapter_id" },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 15,
          "items": { "$ref": "#/definitions/quiz_item" }
        }
      }
    },
    "practice_chapter_set": {
      "type": "object",
      "description": "챕터 1개의 실습 문제 세트",
      "required": ["chapter_id", "items"],
      "properties": {
        "chapter_id": { "$ref": "#/definitions/chapter_id" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/definitions/practice_item" }
        }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/definitions/course_overview" },
    { "$ref": "#/definitions/curriculum_row" },
    { "$ref": "#/definitions/figure_rationale" },
    { "$ref": "#/definitions/material_chapter" },
    { "$ref": "#/definitions/story_chapter" },
    { "$ref": "#/definitions/quiz_chapter_set" },
    { "$ref": "#/definitions/practice_chapter_set" }
  ]
}
