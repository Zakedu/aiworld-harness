# AI World Harness — 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요. .env는 gitignore 처리.

# ===== API Keys =====
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-proj-your-key-here

# ===== Models =====
# 사용자 지정
CLAUDE_MODEL=claude-opus-4-7
OPENAI_MODEL=gpt-5.4

# ===== Server =====
HOST=0.0.0.0
PORT=8000

# ===== Paths =====
DB_PATH=./data/aiworld.db
SCHEMA_PATH=./data/schema-v1.json
RUBRIC_PATH=./data/rubric-v1.yaml
GOLDENS_PATH=./data/goldens

# ===== Runtime =====
MAX_REGEN_RETRIES=3
RUBRIC_OVERALL_PASS=80
